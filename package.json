    "a11y",
    "accessible",
    "ai",
    "bar-chart",
    "bullet-chart",
    "chart",
    "chart-component",
    "charts",
    "data-visualization",
    "dataviz",
    "gauge",
    "heatmap",
    "lightweight",
    "llm",
    "microchart",
    "microcharts",
    "react",
    "react-charts",
    "react-server-components",
    "rsc",
    "server-components",
    "sparkline",
    "sparklines",
    "ssr",
    "svg",
    "tree-shakeable",
    "typescript",
    "visualization",
    "zero-dependency"
  ],
