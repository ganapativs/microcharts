{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks", "typescript", "unicorn"],
  "env": {
    "browser": true,
    "es2023": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // `exhaustive-deps` already errors via the `correctness` category, but
    // `rules-of-hooks` does NOT — verified against a probe file with a
    // conditionally-called `useState`, which passed silently until this line.
    // That is the costlier of the two in a library whose hooks all live in
    // shared entries: a hook behind a prop-dependent branch desyncs the hook
    // order for every chart that composes it. Both are pinned explicitly so
    // neither depends on which category oxlint files them under next.
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "fixtures", "examples", "scripts/figma-export"]
}
