{
  "name": "@microcharts/docs",
  "version": "0.0.16",
  "private": true,
  "description": "microcharts documentation site — Fumadocs + Next.js, static-export, deploy anywhere.",
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "predev": "fumadocs-mdx && node scripts/gen-md.ts",
    "dev": "next dev",
    "gen:entries": "node scripts/gen-entries.mjs",
    "gen:docs-code": "node scripts/gen-docs-code.mjs",
    "gen:preview-live": "node scripts/gen-preview-live.mjs",
    "gen:playground-caps": "node scripts/gen-playground-caps.mjs",
    "gen:chart-modules": "node scripts/gen-chart-modules.mjs",
    "gen:wordmark": "python3 scripts/gen-wordmark-path.py",
    "gen:brand-kit": "node scripts/gen-brand-kit.mjs",
    "prebuild": "node scripts/gen-md.ts",
    "build": "next build",
    "start": "serve out -l 3001",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "vitest run",
    "cf:deploy": "pnpm build && wrangler deploy && pnpm seo:indexnow",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "cf:preview": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "@microcharts/react": "workspace:*",
    "@stackblitz/sdk": "^1.11.1",
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.20.0",
    "postcss": "^8.5.25",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
