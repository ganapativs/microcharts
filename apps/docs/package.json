{
  "name": "@microcharts/docs",
  "version": "0.0.3",
  "private": true,
  "description": "microcharts documentation site — Fumadocs + Next.js, static-export, deploy anywhere.",
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "predev": "fumadocs-mdx && node scripts/gen-md.ts",
    "dev": "next dev",
    "prebuild": "node scripts/gen-md.ts",
    "build": "next build",
    "start": "serve out -l 3001",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "vitest run",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:preview": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "@microcharts/react": "workspace:*",
    "@orama/orama": "^3.1.18",
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.10.7",
    "fumadocs-mdx": "15.0.13",
    "fumadocs-ui": "16.10.7",
    "lucide-react": "^1.21.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.20.0",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
