# Cloudflare Workers Static Assets headers (parsed by wrangler at deploy).
# Next content-hashes everything under /_next/static — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Lighthouse / best-practices security baseline for every HTML + asset response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cross-origin isolation, scoped to the one route that needs it: the Quickstart
# frames a StackBlitz WebContainer inline, which only runs when the host
# document is isolated (COOP + COEP). `credentialless` loads cross-origin
# subresources without credentials rather than blocking them, so the blast
# radius stays on this page. Mirrored in worker.ts for the Cloudflare path.
/docs/quickstart
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-icon
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-192
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-512
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.webmanifest
  Cache-Control: public, max-age=86400
