{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/core/index.ts",
    "src/shared/index.ts",
    "src/charts/*/index.tsx",
    "src/charts/*/client.tsx",
    "src/test/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["fixtures/**"],
  "ignoreWorkspaces": ["fixtures/*"],
  "ignoreDependencies": ["@vitest/browser", "fast-check", "@axe-core/playwright"]
}
